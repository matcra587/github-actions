# Test payload for `bun run await-gates:local` (@github/local-action).
# Copy to .env and adjust; GITHUB_TOKEN comes from your environment
# (e.g. INPUT_TOKEN="$(gh auth token)").
INPUT_GATES="test.yml lint.yml security.yml"
INPUT_REF="v0.3.0"
INPUT_REPOSITORY="matcra587/docent"
INPUT_TOKEN=""
INPUT_DEADLINE-SECONDS="900"
INPUT_GRACE-SECONDS="180"
INPUT_POLL-SECONDS="15"
