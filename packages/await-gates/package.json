{
  "name": "@matcra587/await-gates-action",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "all": "bun run typecheck && bun run test && bun run bundle && bun run check-dist",
    "bundle": "bun build src/index.ts --target=node --format=esm --outfile=dist/index.js",
    "check-dist": "bun build dist/index.js --target=node --format=esm --outfile=/dev/null",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@octokit/plugin-retry": "8.1.0",
    "@octokit/plugin-throttling": "11.0.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "25.9.2",
    "typescript": "6.0.3"
  }
}
