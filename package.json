{
  "name": "@matcra587/github-actions",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "all": "bun run quality && bun run await-gates:all && bun run homebrew:all && bun run validate-skills:all",
    "await-gates:all": "cd packages/await-gates && bun run all",
    "await-gates:bundle": "cd packages/await-gates && bun run bundle",
    "await-gates:local": "ROOT=$PWD; cd packages/await-gates && PATH=\"$ROOT/node_modules/.bin:$PATH\" local-action . src/main.ts .env.example",
    "await-gates:test": "cd packages/await-gates && bun run test",
    "await-gates:typecheck": "cd packages/await-gates && bun run typecheck",
    "homebrew:all": "cd packages/homebrew-publish-formula && bun run all",
    "homebrew:bundle": "cd packages/homebrew-publish-formula && bun run bundle",
    "homebrew:local": "ROOT=$PWD; cd packages/homebrew-publish-formula && PATH=\"$ROOT/node_modules/.bin:$PATH\" local-action . src/main.ts .env.example",
    "homebrew:test": "cd packages/homebrew-publish-formula && bun run test",
    "homebrew:typecheck": "cd packages/homebrew-publish-formula && bun run typecheck",
    "validate-skills:all": "cd packages/validate-skills && bun run all",
    "validate-skills:bundle": "cd packages/validate-skills && bun run bundle",
    "validate-skills:local": "ROOT=$PWD; cd packages/validate-skills && PATH=\"$ROOT/node_modules/.bin:$PATH\" local-action . src/main.ts .env.example",
    "validate-skills:test": "cd packages/validate-skills && bun run test",
    "validate-skills:typecheck": "cd packages/validate-skills && bun run typecheck",
    "quality": "biome ci .",
    "quality:fix": "biome check --write ."
  },
  "devDependencies": {
    "@actions/artifact": "6.2.1",
    "@actions/cache": "6.0.1",
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@biomejs/biome": "2.4.16",
    "@github/local-action": "7.0.1",
    "tsx": "4.22.4"
  }
}
